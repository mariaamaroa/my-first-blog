{
  "name": "youtrack-proxy",
  "version": "1.0.0",
  "description": "Express proxy for fideltour.youtrack.cloud",
  "main": "proxy-server.js",
  "scripts": {
    "start": "node proxy-server.js",
    "comparar": "npx playwright test tests/compare-all.spec.js --headed",
