    "comparar:ci": "npx playwright test tests/compare-all.spec.js && node scripts/generate-report.js",
    "qa": "node agent/index.js",
    "qa:headed": "QA_HEADLESS=false node agent/index.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
